<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>es.udc.gac</groupId>
	<artifactId>jhwloc</artifactId>
	<version>1.1.0</version>
	<packaging>jar</packaging>

	<name>jhwloc</name>
	<url>https://github.com/UDC-GAC/jhwloc</url>
        <licenses>
                <license>
                <name>GNU Lesser General Public License v3.0 or later</name>
                <url>https://www.gnu.org/licenses/lgpl-3.0.txt</url>
                <distribution>repo</distribution>
                </license>
        </licenses>
	<properties>
                <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
                <maven.compiler.version>3.16.0</maven.compiler.version>
                <maven.compiler.release>8</maven.compiler.release>
		<mojo-exec-maven.version>3.6.4</mojo-exec-maven.version>
		<maven.javadoc.version>3.12.0</maven.javadoc.version>
		<maven.jar.version>3.5.1</maven.jar.version>
		<maven.surefire.version>3.6.0</maven.surefire.version>
		<maven.source.version>3.4.0</maven.source.version>
		<!-- JUnit 6 needs Java 17, and jhwloc is built for Java 8 -->
		<junit.version>5.14.4</junit.version>
		<native.path>./src/main/native/</native.path>
		<maven.javadoc.path>./javadoc/</maven.javadoc.path>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<!-- The license and the notice go into the META-INF directory of the jar -->
			<resource>
				<directory>${project.basedir}</directory>
				<includes>
					<include>LICENSE</include>
					<include>NOTICE</include>
				</includes>
				<targetPath>META-INF</targetPath>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${mojo-exec-maven.version}</version>
				<executions>
					<execution>
						<id>make</id>
						<phase>compile</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>make</executable>
							<arguments>
								<argument>-C</argument>
								<argument>${native.path}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>makeClean</id>
						<phase>clean</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>make</executable>
							<arguments>
								<argument>clean</argument>
								<argument>-C</argument>
								<argument>${native.path}</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.version}</version>
				<configuration>
					<release>${maven.compiler.release}</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven.javadoc.version}</version>
				<configuration>
					<outputDirectory>${maven.javadoc.path}</outputDirectory>
					<quiet>true</quiet>
					<!-- Check the syntax of the comments (HTML, references), but not that everything is documented -->
					<doclint>all,-missing</doclint>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven.surefire.version}</version>
				<configuration>
					<!-- The native library is built by make in the compile phase and copied to lib -->
					<argLine>-Djava.library.path=${project.basedir}/lib</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>${maven.jar.version}</version>
				<configuration>
					<outputDirectory>./lib</outputDirectory>
			                <forceCreation>true</forceCreation>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<!-- Name of the module when the jar is in the module path, instead of one derived from the file name -->
							<Automatic-Module-Name>es.udc.gac.jhwloc</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>${maven.source.version}</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
